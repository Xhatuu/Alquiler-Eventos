@page
@model Alquiler_Eventos.Pages.PageCliente.ModificarModel
@{
    ViewData["Title"] = "Modificar Cliente";
}
<div class="text-left">
    <h1 class="display-4 text-center">Modificar un Cliente</h1>
    <hr />
    @if (Model.cliente != null)
    {
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" readonly asp-for="id"/>
                </div>
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input class="form-control" type="text" name="nombre" id="nombre" asp-for="nombre" />
                </div>
                <div class="form-group">
                    <label for="apellido">Apellido:</label>
                    <input class="form-control" type="text" name="apellido" id="apellido" asp-for="apellido" />
                </div>
                <div class="form-group">
                    <label for="direccion">Dirección:</label>
                    <input class="form-control" type="text" name="direccion" id="direccion" asp-for="direccion" />
                </div>
                <div class="form-group">
                    <label for="telefono">Teléfono:</label>
                    <input class="form-control" type="text" name="telefono" id="telefono" asp-for="telefono" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Modificar">Modificar</button>
                <a class="btn btn-warning" asp-page="./Listar">Volver</a>
            </div>
        </div>
    </form>
    }
    else
    {
        <a class="btn btn-warning" asp-page="./Listar">Volver</a>
    }

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>